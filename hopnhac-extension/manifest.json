{
  "manifest_version": 3,
  "name": "Hộp Nhạc - Tạo Mockup & Design",
  "version": "1.1.2",
  "description": "Tạo Mockup + Design cho đơn Hộp Nhạc trên cendo.work: chọn font/màu, nhập chữ, ghép ảnh khách, tự điền vào ô Upload. Có luồng tự động chạy theo lịch + báo Lark.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://cendo.work/*",
    "https://content.pancake.vn/*",
    "https://open.larksuite.com/*"
  ],
  "background": { "service_worker": "bg.js" },
  "options_page": "options.html",
  "action": { "default_title": "Hộp Nhạc – Cài đặt luồng tự động" },
  "content_scripts": [
    {
      "matches": ["https://cendo.work/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cendo.work/*"],
      "js": ["content.js", "auto.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mockup-gomoc.png",
        "assets/mockup-occho.png",
        "assets/BeautiqueDisplay-Medium.otf",
        "assets/BeautiqueDisplay-MediumItalic.otf",
        "assets/MTD-Great-Vibes.otf"
      ],
      "matches": ["https://cendo.work/*"]
    }
  ]
}
